apiVersion: cert-manager.io/v1
kind: Certificate
metadata:
  name: {{ domain | replace('.', '-') }}-stage
  namespace: cert-manager
spec:
  privateKey:
    rotationPolicy: Always
  dnsNames:
    - "keycloak-rancher.{{domain}}"
    - "rancher.{{domain}}"
  issuerRef:
    name: letsencrypt-issuer-stage
    kind: ClusterIssuer
  secretName: "obs-tls-cert-stage"
  secretTemplate:
    annotations:
      reflector.v1.k8s.emberstack.com/reflection-allowed: "true"
      reflector.v1.k8s.emberstack.com/reflection-allowed-namespaces: "ingress-nginx,argocd"  # Control destination namespaces
      reflector.v1.k8s.emberstack.com/reflection-auto-enabled: "true" # Auto create reflection for matching namespaces
      reflector.v1.k8s.emberstack.com/reflection-auto-namespaces: "ingress-nginx,argocd" # Control auto-reflection namespace

---

apiVersion: cert-manager.io/v1
